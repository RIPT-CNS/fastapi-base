# cp .env.example .env
# Every dev/prod difference is in this file. Values below are for dev;
# lines tagged [PROD] show what to change on a production server.

# ============================================================ Docker
COMPOSE_PROJECT_NAME=fastapi-base
# Extra services: "keycloak" runs Keycloak in this stack. [PROD] empty if Keycloak is external
COMPOSE_PROFILES=keycloak
APP_PORT=8000
KEYCLOAK_PORT=8080
DB_PORT=5432
# Host interface of the DB port. 127.0.0.1 = this machine only. [PROD] keep 127.0.0.1
DB_BIND=127.0.0.1
APP_IMAGE=fastapi-base
APP_TAG=latest

# =============================================================== App
# dev = hot reload | prod = WEB_CONCURRENCY workers + strict checks.  [PROD] prod
ENVIRONMENT=dev
WEB_CONCURRENCY=2
# [PROD] false
DEBUG=true
LOG_LEVEL=INFO
# [PROD] true
LOG_JSON=false
# [PROD] false to hide /docs
DOCS_ENABLED=true
PROJECT_NAME=FASTAPI_BASE
VERSION=1.0.0
API_PREFIX=/api
API_VERSION=v1
# Comma separated or ["*"]. [PROD] your frontend domains
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:8000
PAGE_SIZE_DEFAULT=20
PAGE_SIZE_MAX=100

# ========================================================== Database
# Docker always uses db:5432. Running uvicorn on the host: POSTGRES_HOST=localhost, POSTGRES_PORT=DB_PORT
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
# [PROD] strong password
POSTGRES_PASSWORD=postgres
POSTGRES_DB=app
# Full URL, overrides POSTGRES_* when set
# DATABASE_URL=postgresql+psycopg://user:pass@host:5432/dbname
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_ECHO=false

# ================================================== Local auth (JWT)
# [PROD] openssl rand -hex 32  (a key containing "change-me" is refused when ENVIRONMENT=prod)
SECRET_KEY=change-me-dev-only-secret-key-0123456789
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_MINUTES=10080
AUTH_LOCAL_ENABLED=true
# Accept "Authorization: Basic ..." on every endpoint
AUTH_BASIC_ENABLED=true
AUTH_REGISTRATION_ENABLED=true
DEFAULT_USER_ROLES=user

# First admin, created by the migrate service (skipped if the password is empty)
FIRST_SUPERUSER_USERNAME=admin
FIRST_SUPERUSER_EMAIL=admin@example.com
# [PROD] strong password, or empty
FIRST_SUPERUSER_PASSWORD=Admin@123

# ====================================================== Keycloak SSO
KEYCLOAK_ENABLED=true
# Backend -> Keycloak. [PROD] https://sso.example.com when Keycloak is external
KEYCLOAK_SERVER_URL=http://keycloak:8080
# Browser -> Keycloak, also the token issuer. Must match KEYCLOAK_PORT. [PROD] https://sso.example.com
KEYCLOAK_PUBLIC_URL=http://localhost:8080
KEYCLOAK_REALM=fastapi-base
KEYCLOAK_CLIENT_ID=fastapi-backend
# [PROD] secret of the client
KEYCLOAK_CLIENT_SECRET=fastapi-backend-secret
KEYCLOAK_FRONTEND_CLIENT_ID=fastapi-frontend
KEYCLOAK_VERIFY_SSL=true
KEYCLOAK_AUTO_CREATE_USER=true

# --- Keycloak container (COMPOSE_PROFILES=keycloak)
# start-dev | start  ([PROD] start, behind an HTTPS reverse proxy)
KEYCLOAK_MODE=start-dev
KEYCLOAK_ADMIN=admin
# [PROD] strong password
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_DB_NAME=keycloak
# Password of the demo realm users sso-admin / sso-user (imported once, with the realm)
KEYCLOAK_DEMO_PASSWORD=Demo@123
# Allowed redirect URLs of the realm clients. Must match APP_PORT
APP_PUBLIC_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
